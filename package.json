{
  "name": "vela",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && vite build --ssr",
    "preview": "$npm_execpath run build && wrangler dev dist-server/index.js",
    "deploy": "$npm_execpath run build && wrangler deploy dist-server/index.js",
    "cf-typegen": "wrangler types --env-interface CloudflareBindings"
  },
  "dependencies": {
    "hono": "^4.7.10"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.2.3",
    "@cloudflare/vitest-pool-workers": "^0.8.31",
    "@hono/vite-build": "^1.6.1",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "vite-plugin-ssr-hot-reload": "^0.5.0",
    "vitest": "^3.1.4",
    "wrangler": "^4.16.0"
  }
}
