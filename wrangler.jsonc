{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "vela",
  "compatibility_date": "2025-04-03",
  "main": "./src/index.ts",
  "workers_dev": false,
  "routes": [
    {
      "pattern": "vela.tozydev.id.vn",
      "custom_domain": true
    }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "vars": {
    "REPOSITORIES": [
      {
        "name": "releases",
        "private": false,
        "bucket": "VELA_BUCKET",
        "prefix": "releases"
      },
      {
        "name": "snapshots",
        "private": false,
        "bucket": "VELA_BUCKET",
        "prefix": "snapshots"
      },
      {
        "name": "private",
        "private": true,
        "bucket": "VELA_BUCKET",
        "prefix": "private"
      }
    ]
  },
  "r2_buckets": [
    {
      "binding": "VELA_BUCKET",
      "bucket_name": "vela"
    }
  ]
}
